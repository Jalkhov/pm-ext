<?xml version="1.0"?>
<RDF xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:em="http://www.mozilla.org/2004/em-rdf#">
  <Description about="urn:mozilla:install-manifest">
    <em:id>pm-ext-toolbox@jalkhov</em:id>
    <em:name>pm-ext toolbox</em:name>
    <em:version>0.1.0</em:version>
    <em:description>Live-reload development toolbox for Pale Moon add-ons.</em:description>
    <em:creator>Jalkhov</em:creator>
    <em:type>2</em:type>
    <em:bootstrap>true</em:bootstrap>

    <em:targetApplication>
      <Description>
        <em:id>{8de7fcbb-c55c-4fbe-bfc5-fc555c87dbc4}</em:id>
        <em:minVersion>35.0.2</em:minVersion>
        <em:maxVersion>*</em:maxVersion>
      </Description>
    </em:targetApplication>
  </Description>
</RDF>
